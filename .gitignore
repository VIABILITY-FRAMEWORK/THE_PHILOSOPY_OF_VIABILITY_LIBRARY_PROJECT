*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex
*.synctex.gz
*.toc
*.vrb
*.xdv

# LaTeX intermediate files
*.4ct
*.4tc
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.glsdefs
*.lol
*.maf
*.mtc
*.mtc0
